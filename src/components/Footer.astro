---
import { LINKEDIN_URL, INSTAGRAM_URL, EMAIL } from '../lib/social'
const year = new Date().getFullYear()
---

<footer class="mt-32 px-5 sm:px-8 pb-10">
  <div class="container-page border-t border-border pt-12">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8">
      <div>
        <p class="font-serif text-3xl sm:text-4xl leading-tight" style="font-weight:700">Have a hard product problem?</p>
        <a href={`mailto:${EMAIL}`} class="text-lg text-muted hover:text-fg transition-colors">{EMAIL}</a>
      </div>
      <nav aria-label="Elsewhere" class="flex flex-wrap gap-6 text-[15px]">
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-fg transition-colors">LinkedIn</a>
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-fg transition-colors">Instagram</a>
        <a href="/people" class="text-muted hover:text-fg transition-colors">People</a>
        <a href="/jobs" class="text-muted hover:text-fg transition-colors">Jobs</a>
      </nav>
    </div>
    <p class="mt-12 text-sm text-muted">© {year} Asif Asharaf · Bengaluru</p>
  </div>
</footer>
