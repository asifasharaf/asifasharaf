---
import { LINKEDIN_URL, INSTAGRAM_URL, EMAIL } from '../lib/social'
const year = new Date().getFullYear()
---

<footer class="mt-32 px-5 sm:px-8 pt-20 pb-10 bg-[#3357ff] text-white relative overflow-hidden border-t-2 border-ink">
  <div aria-hidden="true" class="absolute -right-24 top-10 w-80 h-80 rounded-full bg-lime border-2 border-[#111216]"></div>
  <div aria-hidden="true" class="absolute right-72 -top-10 w-28 h-28 rounded-3xl bg-pink border-2 border-[#111216] rotate-12"></div>
  <div aria-hidden="true" class="absolute right-24 bottom-40 w-0 h-0 border-l-[46px] border-r-[46px] border-b-[80px] border-l-transparent border-r-transparent border-b-sun hidden md:block"></div>
  <div class="container-page relative">
    <div class="grid-12 gap-y-10">
      <div class="col-span-4 md:col-span-8">
        <span class="chip bg-white text-[#111216] border-[#111216] mb-8">👋 Get in touch</span>
        <h2 class="font-serif text-[clamp(3rem,8.5vw,8rem)] leading-[0.92]" style="font-weight:800;letter-spacing:-0.045em">
          Have a hard product<br />problem? <em class="hl hl-lime">Let's talk.</em>
        </h2>
      </div>
      <div class="col-span-4 md:col-span-4 md:self-end flex flex-col gap-3 bg-[#3357ff]/80 backdrop-blur-sm rounded-2xl">
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between border-t border-white/30 py-4 hover:text-lime transition-colors">
          <span class="text-lg">LinkedIn</span><span class="font-mono text-xs group-hover:translate-x-1 transition-transform">↗</span>
        </a>
        <a href={`mailto:${EMAIL}`} class="group flex items-center justify-between border-t border-white/30 py-4 hover:text-lime transition-colors">
          <span class="text-lg">{EMAIL}</span><span class="font-mono text-xs group-hover:translate-x-1 transition-transform">→</span>
        </a>
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between border-y border-white/30 py-4 hover:text-lime transition-colors">
          <span class="text-lg">Instagram</span><span class="font-mono text-xs group-hover:translate-x-1 transition-transform">↗</span>
        </a>
      </div>
    </div>

    <div class="mt-24 pt-6 border-t border-white/30 grid-12 gap-y-4 font-mono text-[11px] uppercase tracking-[0.12em] text-white/70">
      <p class="col-span-4 md:col-span-3">© {year} Asif Asharaf</p>
      <p class="col-span-4 md:col-span-3">Bengaluru, India</p>
      <nav aria-label="More" class="col-span-4 md:col-span-3 flex gap-5">
        <a href="/people" class="hover:text-white transition-colors">People I respect</a>
        <a href="/jobs" class="hover:text-white transition-colors">Jobs</a>
      </nav>
      <p class="col-span-4 md:col-span-3 md:text-right">Set in Bricolage Grotesque &amp; DM Sans</p>
    </div>
  </div>
</footer>
