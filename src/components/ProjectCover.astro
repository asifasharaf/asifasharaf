---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'

interface Props {
  entry: CollectionEntry<'work'>
  class?: string
  eager?: boolean
}

const { entry, class: className = 'aspect-[4/3]', eager = false } = Astro.props
const { title, coverImage, cover } = entry.data

const W = 1600
const H = 1200

// Deterministic pseudo-random so covers are stable between builds.
let seed = [...entry.slug].reduce((a, c) => a + c.charCodeAt(0), 7)
const rand = () => {
  seed = (seed * 9301 + 49297) % 233280
  return seed / 233280
}

// Ink on paper, one accent per project.
const accents: Record<string, string> = {
  signals: '--rgb-accent',
  newsroom: '--rgb-coral',
  notes: '--rgb-lilac',
  tiers: '--rgb-mint',
  studio: '--rgb-pink',
  contours: '--rgb-sun',
}
const accent = `rgb(var(${accents[cover ?? ''] ?? '--rgb-accent'}))`
const ink = 'currentColor'

// signals: account-engagement lines
const series = Array.from({ length: 7 }, (_, s) => {
  const base = 820 - s * 70
  const pts = Array.from({ length: 13 }, (_, i) => {
    const x = 140 + i * 110
    const y = base - Math.sin(i * 0.6 + s) * 40 - (s === 2 ? i * i * 2.6 : rand() * 60)
    return [x, Math.max(220, y)]
  })
  return pts
})
const toPath = (pts: number[][]) => pts.map((p, i) => `${i ? 'L' : 'M'}${p[0].toFixed(0)} ${p[1].toFixed(0)}`).join(' ')

// tiers: which frames on the contact sheet are keepers
const sheet = Array.from({ length: 4 }, () => Array.from({ length: 7 }, () => rand()))

// contours: hill lines
const contours = Array.from({ length: 22 }, (_, k) => {
  const y0 = 300 + k * 38
  const amp = 120 - k * 3
  const pts = Array.from({ length: 41 }, (_, i) => {
    const x = (W / 40) * i
    const y = y0 - Math.sin(i / 6 + k * 0.18) * amp * 0.6 - Math.cos(i / 3.1 - k * 0.25) * amp * 0.25
    return [x, y]
  })
  return toPath(pts)
})

// studio: waveform
const wave = Array.from({ length: 64 }, (_, i) => {
  const env = Math.sin((i / 63) * Math.PI)
  return 20 + env * (80 + rand() * 260)
})
---

<div class:list={['cover-plate pop bg-bg text-fg', className]}>
  <div class="cover-inner">
    {
      coverImage ? (
        <div class="absolute inset-0 grid place-items-center p-[9%]">
          <span class="absolute top-[5%] left-[4%] font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.1em] flex items-center gap-2">
            <span class="dot" style={`background:${accent}`}></span>
            {title}
          </span>
          <div class="relative max-h-full">
            <span aria-hidden="true" class="absolute inset-0 translate-x-3 translate-y-3 rounded-[12px] border-[1.5px]" style={`border-color:${accent}`}></span>
            <Image
              src={coverImage}
              alt={title}
              width={1200}
              loading={eager ? 'eager' : 'lazy'}
              class="relative max-h-full w-auto max-w-full object-contain rounded-[12px] border border-ink"
            />
          </div>
        </div>
      ) : (
        <svg viewBox={`0 0 ${W} ${H}`} class="absolute inset-0 w-full h-full" role="img" aria-label={`${title} cover`} preserveAspectRatio="xMidYMid slice">
          {cover === 'signals' && (
            <g>
              {Array.from({ length: 12 }, (_, i) => (
                <line x1={140 + i * 120} y1="160" x2={140 + i * 120} y2="900" stroke={ink} stroke-opacity="0.1" stroke-width="2" />
              ))}
              {Array.from({ length: 7 }, (_, i) => (
                <line x1="140" y1={200 + i * 120} x2="1460" y2={200 + i * 120} stroke={ink} stroke-opacity="0.1" stroke-width="2" />
              ))}
              {series.map((pts, s) => (
                <path d={toPath(pts)} fill="none" stroke={s === 2 ? accent : ink} stroke-opacity={s === 2 ? 1 : 0.35} stroke-width={s === 2 ? 7 : 2.5} stroke-linejoin="round" />
              ))}
              {series[2].filter((_, i) => i % 3 === 0).map((p) => (
                <circle cx={p[0]} cy={p[1]} r="12" fill="rgb(var(--rgb-bg))" stroke={accent} stroke-width="6" />
              ))}
              <text x="140" y="120" font-family="DM Mono, monospace" font-size="30" letter-spacing="3" fill={ink}>ACCOUNTS IN MARKET · LAST 90 DAYS</text>
              <g transform="translate(980 990)">
                <rect width="480" height="130" rx="65" fill="none" stroke={ink} stroke-width="3" />
                <circle cx="65" cy="65" r="18" fill={accent} />
                <text x="100" y="58" font-family="DM Sans, sans-serif" font-weight="600" font-size="32" fill={ink}>Agent · route to AE</text>
                <text x="100" y="98" font-family="DM Mono, monospace" font-size="22" letter-spacing="2" fill={ink} fill-opacity="0.6">INTENT ↑ 3 SIGNALS</text>
              </g>
              <text x="140" y="1090" font-family="Bricolage Grotesque, sans-serif" font-size="170" font-weight="800" letter-spacing="-6" fill={ink}>2,481</text>
            </g>
          )}
          {cover === 'newsroom' && (
            <g fill={ink}>
              <rect x="140" y="140" width="1320" height="6" />
              <text x="140" y="250" font-family="Bricolage Grotesque, sans-serif" font-size="104" font-weight="800" letter-spacing="-4">The Morning Edition</text>
              <text x="1460" y="250" text-anchor="end" font-family="DM Mono, monospace" font-size="26" letter-spacing="4">BOLD · DRAFT 04</text>
              <rect x="140" y="290" width="1320" height="2" />
              <rect x="140" y="340" width="860" height="64" rx="4" />
              <rect x="140" y="424" width="620" height="64" rx="4" />
              {Array.from({ length: 3 }, (_, c) =>
                Array.from({ length: 14 }, (_, l) => (
                  <rect x={140 + c * 300} y={560 + l * 36} width={l % 5 === 4 ? 160 : 260} height="10" rx="5" fill-opacity="0.35" />
                )),
              )}
              <rect x="1060" y="340" width="400" height="300" rx="4" fill="none" stroke={ink} stroke-width="3" />
              {Array.from({ length: 16 }, (_, i) => (
                <line x1={1060 + i * 28} y1="640" x2={1060 + i * 28 + 300} y2="340" stroke={ink} stroke-opacity="0.25" stroke-width="2" clip-path="url(#nwclip)" />
              ))}
              <clipPath id="nwclip"><rect x="1060" y="340" width="400" height="300" /></clipPath>
              <rect x="1060" y="700" width="400" height="10" rx="5" fill-opacity="0.35" />
              <rect x="1060" y="736" width="300" height="10" rx="5" fill-opacity="0.35" />
              <rect x="738" y="1006" width="5" height="64" fill={accent} />
              <g transform="translate(1180 1000)">
                <rect width="280" height="80" rx="40" fill={accent} />
                <text x="140" y="52" text-anchor="middle" font-family="DM Mono, monospace" font-size="26" letter-spacing="4" fill="#111216">PUBLISH</text>
              </g>
            </g>
          )}
          {cover === 'tiers' && (
            <g>
              {['01  BEST PICKS', '02  ALL GOOD', '03  ALMOST GOOD', '04  TO DELETE'].map((label, r) => (
                <g transform={`translate(140 ${170 + r * 250})`}>
                  <text y="-20" font-family="DM Mono, monospace" font-size="24" letter-spacing="4" fill={ink}>{label}</text>
                  {sheet[r].map((v, i) => {
                    const keeper = r === 0 && i < 2
                    return (
                      <g>
                        <rect x={i * 190} y="0" width="170" height="170" rx="4" fill="none" stroke={keeper ? accent : ink} stroke-width={keeper ? 9 : 2.5} stroke-opacity={r === 3 ? 0.35 : 1} />
                        <path d={`M${i * 190 + 18} 150 L${i * 190 + 62} ${80 + v * 40} L${i * 190 + 96} 120 L${i * 190 + 128} ${70 + v * 30} L${i * 190 + 152} 150`} fill="none" stroke={ink} stroke-opacity={r === 3 ? 0.25 : 0.6} stroke-width="3" stroke-linejoin="round" />
                        <circle cx={i * 190 + 128} cy="44" r="12" fill="none" stroke={ink} stroke-opacity={r === 3 ? 0.25 : 0.6} stroke-width="3" />
                        {r === 3 && <line x1={i * 190 + 10} y1="10" x2={i * 190 + 160} y2="160" stroke={ink} stroke-opacity="0.35" stroke-width="2.5" />}
                      </g>
                    )
                  })}
                </g>
              ))}
            </g>
          )}
          {cover === 'studio' && (
            <g>
              {Array.from({ length: 9 }, (_, i) => (
                <circle cx="800" cy="600" r={120 + i * 70} fill="none" stroke={ink} stroke-opacity={0.3 - i * 0.03} stroke-width="2" />
              ))}
              {wave.map((h, i) => (
                <rect x={160 + i * 20.3} y={600 - h / 2} width="9" height={h} rx="4.5" fill={ink} />
              ))}
              <circle cx="160" cy="160" r="16" fill={accent} />
              <text x="192" y="170" font-family="DM Mono, monospace" font-size="28" letter-spacing="3" fill={ink}>REC  00:42:17</text>
              <text x="1440" y="1080" text-anchor="end" font-family="Bricolage Grotesque, sans-serif" font-weight="800" letter-spacing="-4" font-size="110" fill={ink}>from concept to final cut</text>
            </g>
          )}
          {cover === 'contours' && (
            <g>
              {contours.map((d, k) => (
                <path d={d} fill="none" stroke={k === 14 ? accent : ink} stroke-opacity={k === 14 ? 1 : 0.12 + (k / contours.length) * 0.55} stroke-width={k === 14 ? 7 : 2.5} />
              ))}
              <text x="140" y="170" font-family="DM Mono, monospace" font-size="26" letter-spacing="3" fill={ink}>MUNNAR · 10.08° N 77.06° E</text>
              <text x="140" y="1080" font-family="Bricolage Grotesque, sans-serif" font-weight="800" letter-spacing="-8" font-size="210" fill={ink}>Foxbrain</text>
            </g>
          )}
          {!cover && (
            <text x="800" y="680" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-weight="800" font-size="320" fill="rgb(var(--rgb-muted))">{title.charAt(0)}</text>
          )}
        </svg>
      )
    }
  </div>
</div>
