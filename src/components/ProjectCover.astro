---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'

interface Props {
  entry: CollectionEntry<'work'>
  class?: string
  eager?: boolean
}

const { entry, class: className = 'aspect-[4/3]', eager = false } = Astro.props
const { title, coverImage, cover } = entry.data

const W = 1600
const H = 1200

// Deterministic pseudo-random so covers are stable between builds.
let seed = [...entry.slug].reduce((a, c) => a + c.charCodeAt(0), 7)
const rand = () => {
  seed = (seed * 9301 + 49297) % 233280
  return seed / 233280
}

const plates: Record<string, string> = {
  signals: '#3357ff',
  newsroom: '#ffc93c',
  notes: '#b69cff',
  tiers: '#3dd9b3',
  studio: '#ff6b4a',
  contours: '#c6f03c',
}
const plate = plates[cover ?? ''] ?? 'rgb(var(--rgb-surface))'

// signals: account-engagement lines
const series = Array.from({ length: 7 }, (_, s) => {
  const base = 820 - s * 70
  const pts = Array.from({ length: 13 }, (_, i) => {
    const x = 140 + i * 110
    const y = base - Math.sin(i * 0.6 + s) * 40 - (s === 2 ? i * i * 2.6 : rand() * 60)
    return [x, Math.max(220, y)]
  })
  return pts
})
const toPath = (pts: number[][]) => pts.map((p, i) => `${i ? 'L' : 'M'}${p[0].toFixed(0)} ${p[1].toFixed(0)}`).join(' ')

// tiers: contact sheet tones
const sheet = Array.from({ length: 4 }, (_, r) =>
  Array.from({ length: 7 }, () => 30 + Math.floor(rand() * 60) - r * 6),
)

// contours: hill lines
const contours = Array.from({ length: 22 }, (_, k) => {
  const y0 = 300 + k * 38
  const amp = 120 - k * 3
  const pts = Array.from({ length: 41 }, (_, i) => {
    const x = (W / 40) * i
    const y = y0 - Math.sin(i / 6 + k * 0.18) * amp * 0.6 - Math.cos(i / 3.1 - k * 0.25) * amp * 0.25
    return [x, y]
  })
  return toPath(pts)
})

// studio: waveform
const wave = Array.from({ length: 64 }, (_, i) => {
  const env = Math.sin((i / 63) * Math.PI)
  return 20 + env * (80 + rand() * 260)
})
---

<div class:list={['cover-plate pop', className]} style={`background:${plate}`}>
  <div class="cover-inner">
    {
      coverImage ? (
        <div class="absolute inset-0 grid place-items-center p-[9%]">
          <Image
            src={coverImage}
            alt={title}
            width={1200}
            loading={eager ? 'eager' : 'lazy'}
            class="max-h-full w-auto max-w-full object-contain rounded-[14px]"
            style="box-shadow: 0 40px 80px -30px rgba(30,10,90,.45), 0 0 0 2px #111216"
          />
        </div>
      ) : (
        <svg viewBox={`0 0 ${W} ${H}`} class="absolute inset-0 w-full h-full" role="img" aria-label={`${title} cover`} preserveAspectRatio="xMidYMid slice">
          {cover === 'signals' && (
            <g>
              {Array.from({ length: 12 }, (_, i) => (
                <line x1={140 + i * 120} y1="160" x2={140 + i * 120} y2="900" stroke="#ffffff" stroke-opacity="0.14" stroke-width="2" />
              ))}
              {Array.from({ length: 7 }, (_, i) => (
                <line x1="140" y1={200 + i * 120} x2="1460" y2={200 + i * 120} stroke="#26282f" stroke-width="2" />
              ))}
              {series.map((pts, s) => (
                <path d={toPath(pts)} fill="none" stroke={s === 2 ? '#c6f03c' : '#ffffff'} stroke-opacity={s === 2 ? 1 : 0.35} stroke-width={s === 2 ? 6 : 3} stroke-linejoin="round" />
              ))}
              {series[2].filter((_, i) => i % 3 === 0).map((p) => (
                <circle cx={p[0]} cy={p[1]} r="11" fill="#3357ff" stroke="#c6f03c" stroke-width="6" />
              ))}
              <text x="140" y="120" font-family="DM Mono, monospace" font-size="30" letter-spacing="3" fill="#ffffff" fill-opacity="0.8">ACCOUNTS IN MARKET · LAST 90 DAYS</text>
              <g transform="translate(980 990)">
                <rect width="480" height="130" rx="65" fill="#111216" />
                <circle cx="65" cy="65" r="18" fill="#c6f03c" />
                <text x="100" y="58" font-family="DM Sans, sans-serif" font-weight="600" font-size="32" fill="#ffffff">Agent · route to AE</text>
                <text x="100" y="98" font-family="DM Mono, monospace" font-size="22" letter-spacing="2" fill="#c6f03c">INTENT ↑ 3 SIGNALS</text>
              </g>
              <text x="140" y="1090" font-family="Bricolage Grotesque, sans-serif" font-size="170" font-weight="800" letter-spacing="-6" fill="#ffffff">2,481</text>
            </g>
          )}
          {cover === 'newsroom' && (
            <g fill="#111216">
              <rect x="140" y="140" width="1320" height="6" />
              <text x="140" y="250" font-family="Bricolage Grotesque, sans-serif" font-size="104" font-weight="800" letter-spacing="-4">The Morning Edition</text>
              <text x="1460" y="250" text-anchor="end" font-family="DM Mono, monospace" font-size="26" letter-spacing="4" fill="#111216">BOLD · DRAFT 04</text>
              <rect x="140" y="290" width="1320" height="2" />
              <rect x="140" y="340" width="860" height="70" rx="4" />
              <rect x="140" y="430" width="620" height="70" rx="4" />
              {Array.from({ length: 3 }, (_, c) =>
                Array.from({ length: 14 }, (_, l) => (
                  <rect x={140 + c * 300} y={560 + l * 36} width={l % 5 === 4 ? 160 : 260} height="12" rx="6" fill="#111216" fill-opacity="0.55" />
                )),
              )}
              <rect x="1060" y="340" width="400" height="300" rx="16" fill="#ff6b4a" />
              {Array.from({ length: 16 }, (_, i) => (
                <line x1={1060 + i * 28} y1="640" x2={1060 + i * 28 + 300} y2="340" stroke="#ffc93c" stroke-width="3" clip-path="url(#nwclip)" />
              ))}
              <clipPath id="nwclip"><rect x="1060" y="340" width="400" height="300" /></clipPath>
              <rect x="1060" y="700" width="400" height="12" rx="6" fill="#111216" fill-opacity="0.55" />
              <rect x="1060" y="736" width="300" height="12" rx="6" fill="#111216" fill-opacity="0.55" />
              <rect x="738" y="1010" width="4" height="60" fill="#3357ff" />
              <g transform="translate(1180 1000)">
                <rect width="280" height="80" rx="40" fill="#111216" />
                <text x="140" y="52" text-anchor="middle" font-family="DM Mono, monospace" font-size="26" letter-spacing="4" fill="#fff">PUBLISH</text>
              </g>
            </g>
          )}
          {cover === 'tiers' && (
            <g>
              {['01  BEST PICKS', '02  ALL GOOD', '03  ALMOST GOOD', '04  TO DELETE'].map((label, r) => (
                <g transform={`translate(140 ${170 + r * 250})`}>
                  <text y="-20" font-family="DM Mono, monospace" font-size="24" letter-spacing="4" fill="#111216">{label}</text>
                  {sheet[r].map((tone, i) => (
                    <rect x={i * 190} y="0" width="170" height="170" rx="6" fill={['#ffffff', '#111216', '#3357ff', '#ffc93c', '#ff8bd1', '#b69cff', '#ff6b4a'][(i + r * 3) % 7]} opacity={r === 3 ? 0.3 : 1} stroke="#111216" stroke-width={r === 0 && i < 2 ? 10 : 3} />
                  ))}
                </g>
              ))}
            </g>
          )}
          {cover === 'studio' && (
            <g>
              {Array.from({ length: 9 }, (_, i) => (
                <circle cx="800" cy="600" r={120 + i * 70} fill="none" stroke="#ffffff" stroke-opacity={0.6 - i * 0.06} stroke-width="2" />
              ))}
              {wave.map((h, i) => (
                <rect x={160 + i * 20.3} y={600 - h / 2} width="9" height={h} rx="4.5" fill="#111216" />
              ))}
              <circle cx="160" cy="160" r="14" fill="#ffffff" />
              <text x="190" y="170" font-family="DM Mono, monospace" font-size="28" letter-spacing="3" fill="#ffffff">REC  00:42:17</text>
              <text x="1440" y="1080" text-anchor="end" font-family="Bricolage Grotesque, sans-serif" font-weight="800" letter-spacing="-4" font-size="110" fill="#111216">from concept to final cut</text>
            </g>
          )}
          {cover === 'contours' && (
            <g>
              {contours.map((d, k) => (
                <path d={d} fill="none" stroke="#111216" stroke-opacity={0.15 + (k / contours.length) * 0.7} stroke-width="2.5" />
              ))}
              <text x="140" y="170" font-family="DM Mono, monospace" font-size="26" letter-spacing="3" fill="#111216">MUNNAR · 10.08° N 77.06° E</text>
              <text x="140" y="1080" font-family="Bricolage Grotesque, sans-serif" font-weight="800" letter-spacing="-8" font-size="210" fill="#111216">Foxbrain</text>
            </g>
          )}
          {!cover && (
            <text x="800" y="680" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-weight="800" font-size="320" fill="rgb(var(--rgb-muted))">{title.charAt(0)}</text>
          )}
        </svg>
      )
    }
  </div>
</div>
