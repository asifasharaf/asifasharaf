---
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'writing'>
}

const { entry } = Astro.props
const { title, publishedAt, summary, tags } = entry.data

const dateFormatted = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
}).format(new Date(publishedAt))
---

<a
  href={`/writing/${entry.slug}`}
  class="group grid grid-cols-4 md:grid-cols-9 gap-x-6 gap-y-2 py-7 border-b border-border items-baseline"
>
  <time datetime={new Date(publishedAt).toISOString()} class="col-span-4 md:col-span-2 font-mono text-xs uppercase tracking-[0.1em] text-muted tabular-nums">
    {dateFormatted}
  </time>
  <div class="col-span-4 md:col-span-6">
    <h3 class="font-serif text-2xl sm:text-[2rem] leading-[1.1] text-fg group-hover:text-accent transition-colors mb-2">
      {title}
    </h3>
    <p class="text-muted leading-relaxed">{summary}</p>
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-4">
          {tags.map((tag) => (
            <span class="tag-pill">{tag}</span>
          ))}
        </div>
      )
    }
  </div>
  <span class="hidden md:block md:col-span-1 justify-self-end font-mono text-sm text-muted group-hover:text-accent group-hover:translate-x-1 transition-all">→</span>
</a>
