---
import ThemeToggle from './ThemeToggle.astro'
import { LINKEDIN_URL } from '../lib/social'

const pathname = Astro.url.pathname

const links = [
  { href: '/work', label: 'Work' },
  { href: '/writing', label: 'Writing' },
  { href: '/people', label: 'People' },
  { href: '/about', label: 'About' },
]
---

<header class="w-full px-6 sm:px-8 py-6">
  <div class="container-page flex items-center justify-between">
  <a
    href="/"
    class="text-fg hover:text-accent transition-colors text-sm uppercase tracking-[0.18em] font-medium"
    aria-label="Asif Asharaf — home"
  >
    Asif Asharaf
  </a>

  <nav aria-label="Main navigation" class="flex items-center gap-4 sm:gap-8">
    <ul class="hidden sm:flex items-center gap-6 sm:gap-8">
      {
        links.map((link) => {
          const isActive = pathname.startsWith(link.href)
          return (
            <li>
              <a
                href={link.href}
                class:list={[
                  'text-sm tracking-wide transition-colors',
                  isActive ? 'text-fg' : 'text-muted hover:text-fg',
                ]}
              >
                {link.label}
              </a>
            </li>
          )
        })
      }
    </ul>

    <ThemeToggle />

    <a
      href={LINKEDIN_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden sm:inline-block text-sm uppercase tracking-[0.14em] border border-border hover:border-accent hover:text-accent text-fg px-4 py-2 rounded-full transition-colors"
    >
      Say hello
    </a>
  </nav>
  </div>
</header>
