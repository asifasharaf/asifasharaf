---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import { personColor } from '../lib/palette'

interface Props {
  entry: CollectionEntry<'people'>
  compact?: boolean
}

const { entry, compact = false } = Astro.props
const { name, role, location, tags, asifsTake, avatar, relationship } = entry.data
const color = personColor(name)
const takeExcerpt = asifsTake.length > 150 ? asifsTake.slice(0, 147) + '…' : asifsTake
---

<a href={`/people/${entry.slug}`} class="group flex flex-col h-full border-t-[3px] border-ink pt-5">
  <div class="flex items-center gap-4 mb-6">
    <div class="shrink-0 w-14 h-14 rounded-full border border-ink overflow-hidden grid place-items-center">
      {
        avatar ? (
          <Image src={avatar} alt={name} width={112} height={112} class="w-full h-full object-cover" />
        ) : (
          <span class="font-serif text-2xl" style="font-weight:800">{name.charAt(0)}</span>
        )
      }
    </div>
    <div class="min-w-0">
      <h3 class="font-serif text-2xl leading-tight truncate group-hover:underline decoration-2 underline-offset-4" style="font-weight:800">{name}</h3>
      <p class="text-muted text-sm truncate">{role} · {location}</p>
    </div>
  </div>

  <p class="text-fg/80 leading-relaxed mb-6 flex-1">“{takeExcerpt}”</p>

  <div class="flex flex-wrap items-center gap-1.5">
    <span class="chip"><span class:list={['dot', color]}></span>{relationship}</span>
    {!compact && tags.slice(0, 2).map((tag) => <span class="tag-pill">{tag}</span>)}
  </div>
</a>
