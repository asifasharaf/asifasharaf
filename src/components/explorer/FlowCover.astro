---
/**
 * Animated cover for the AI-and-design page.
 *
 * A slow-drifting stream of layered organic bands — one per phase of design
 * work, in the site's existing palette at low alpha. It is not decoration for
 * its own sake: the bands are the same six phases the page's charts use, so the
 * cover reads as the subject (a week of work, flowing and redistributing)
 * rather than as a stock gradient.
 *
 * Zero JS. Paths are generated at build time, and the drift is a CSS transform.
 * Each band's wave is built from harmonics whose period divides LOOP exactly,
 * so translating by -LOOP is seamless and the loop has no visible seam.
 */

const LOOP = 1200 // px of viewBox after which the wave repeats exactly
const W = LOOP * 2 // two copies laid end to end, so translation never gaps
const H = 460
const SAMPLES = 220

interface Band {
  token: string
  yBase: number
  amps: [number, number, number]
  phases: [number, number, number]
  /** seconds for one full LOOP of drift — different per band for parallax */
  duration: number
  opacity: number
}

const BANDS: Band[] = [
  { token: '--rgb-cobalt',  yBase: 150, amps: [26, 11, 5], phases: [0.0, 1.7, 3.1], duration: 92, opacity: 0.16 },
  { token: '--rgb-mustard', yBase: 196, amps: [30, 9, 6],  phases: [0.9, 2.4, 0.4], duration: 78, opacity: 0.17 },
  { token: '--rgb-rose',    yBase: 242, amps: [24, 13, 4], phases: [1.8, 0.3, 2.2], duration: 66, opacity: 0.16 },
  { token: '--rgb-accent',  yBase: 288, amps: [32, 10, 7], phases: [2.6, 1.1, 4.0], duration: 57, opacity: 0.18 },
  { token: '--rgb-olive',   yBase: 334, amps: [22, 12, 5], phases: [3.4, 2.9, 1.3], duration: 48, opacity: 0.17 },
  { token: '--rgb-fg',      yBase: 380, amps: [18, 8, 4],  phases: [4.2, 0.7, 2.8], duration: 41, opacity: 0.07 },
]

/** y at x for a band: three harmonics, all with periods dividing LOOP. */
function yAt(band: Band, x: number): number {
  const t = (x / LOOP) * Math.PI * 2
  return (
    band.yBase +
    band.amps[0] * Math.sin(t + band.phases[0]) +
    band.amps[1] * Math.sin(2 * t + band.phases[1]) +
    band.amps[2] * Math.sin(3 * t + band.phases[2])
  )
}

/** Closed path: the wave across the full width, then down and back. */
function bandPath(band: Band): string {
  const step = W / SAMPLES
  const pts: string[] = []
  for (let i = 0; i <= SAMPLES; i++) {
    const x = i * step
    const y = yAt(band, x)
    pts.push(`${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`)
  }
  return `${pts.join(' ')} L${W} ${H} L0 ${H} Z`
}

/** A thin highlight stroke riding the top edge of each band. */
function crestPath(band: Band): string {
  const step = W / SAMPLES
  const pts: string[] = []
  for (let i = 0; i <= SAMPLES; i++) {
    const x = i * step
    pts.push(`${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${yAt(band, x).toFixed(1)}`)
  }
  return pts.join(' ')
}

const bands = BANDS.map((b) => ({
  ...b,
  fill: bandPath(b),
  crest: crestPath(b),
}))
---

<div class="flow-cover" aria-hidden="true">
  <svg viewBox={`0 0 ${LOOP} ${H}`} preserveAspectRatio="xMidYMid slice" class="flow-cover__svg">
    {
      bands.map((b) => (
        <g class="flow-cover__band" style={`--dur:${b.duration}s; --loop:${LOOP}px`}>
          <path d={b.fill} style={`fill: rgb(var(${b.token}) / ${b.opacity})`} />
          <path
            d={b.crest}
            fill="none"
            style={`stroke: rgb(var(${b.token}) / ${b.opacity + 0.22}); stroke-width: 1.25`}
          />
        </g>
      ))
    }
  </svg>
</div>

<style>
  .flow-cover {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Fades into the page rather than ending on a hard edge. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 18%,
      black 72%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 18%,
      black 72%,
      transparent 100%
    );
  }

  .flow-cover__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* The path data is two loops wide, so shifting by exactly one loop is seamless. */
  .flow-cover__band {
    animation: flow-drift var(--dur) linear infinite;
    will-change: transform;
  }

  @keyframes flow-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-1 * var(--loop)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-cover__band {
      animation: none;
    }
  }
</style>
