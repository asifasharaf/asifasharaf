---
import Glyph from './Glyph.astro'
import type { GlyphName } from '../lib/glyphs'

// A scene read left to right: where I come from (hills, boat, deer, fish),
// the work (a maker drawing a frame, the pen tool, a chart), and the sun over it.
type Mark = { n: GlyphName; x: number; y: number; s: number; r?: number; tone?: 'cream' | 'ink' | 'sun' | 'lime' }
const marks: Mark[] = [
  { n: 'sun', x: 18, y: 18, s: 120, tone: 'sun' },
  { n: 'bird', x: 168, y: 34, s: 92, r: -8, tone: 'cream' },
  { n: 'eye', x: 285, y: 44, s: 80, tone: 'cream' },
  { n: 'hills', x: 382, y: 14, s: 160, tone: 'cream' },
  { n: 'pen', x: 18, y: 168, s: 112, r: -6, tone: 'cream' },
  { n: 'maker', x: 148, y: 128, s: 250, tone: 'ink' },
  { n: 'cursor', x: 360, y: 140, s: 56, r: -10, tone: 'lime' },
  { n: 'deer', x: 398, y: 176, s: 150, tone: 'cream' },
  { n: 'fish', x: 26, y: 298, s: 92, r: 8, tone: 'cream' },
  { n: 'fish', x: 52, y: 372, s: 66, r: -6, tone: 'cream' },
  { n: 'chart', x: 434, y: 330, s: 96, tone: 'ink' },
  { n: 'dots', x: 380, y: 384, s: 52, tone: 'ink' },
  { n: 'boat', x: 128, y: 322, s: 250, tone: 'cream' },
  { n: 'spiral', x: 24, y: 454, s: 84, tone: 'ink' },
  { n: 'hand', x: 446, y: 446, s: 86, r: 10, tone: 'sun' },
  { n: 'waves', x: 196, y: 470, s: 120, tone: 'cream' },
]
const tones = { cream: '#fff3e2', ink: '#111216', sun: '#ffc93c', lime: '#c6f03c' }
---

<figure class="w-full max-w-[560px] mx-auto">
<div class="pop relative aspect-square w-full rounded-[28px] overflow-hidden" style="background: radial-gradient(120% 90% at 30% 20%, #ff8a5c 0%, #ef5f3c 45%, #c9472c 100%)">
  <svg viewBox="0 0 560 560" class="absolute inset-0 w-full h-full" role="img" aria-label="Cave painting of a person drawing a design frame, with a sun, hills, a deer, fish and a Kerala snake boat">
    {
      marks.map((m, i) => (
        <g class="glyph-wiggle" style={`color:${tones[m.tone ?? 'cream']}`}>
          <Glyph name={m.n} x={m.x} y={m.y} size={m.s} rotate={m.r} weight={m.s > 150 ? 3.6 : 5} draw delay={150 + i * 110} />
        </g>
      ))
    }
  </svg>
</div>
<figcaption class="mt-4 text-right font-mono text-[10px] uppercase tracking-[0.1em] text-muted">After the Edakkal petroglyphs · Wayanad, Kerala</figcaption>
</figure>
