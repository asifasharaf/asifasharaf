---
interface Props {
  chip: string
  glow?: 'lilac' | 'lime' | 'sun' | 'mint' | 'coral' | 'sky'
}

const { chip, glow = 'lilac' } = Astro.props
const glows: Record<string, string> = {
  lilac: 'bg-lilac/35',
  lime: 'bg-lime/35',
  sun: 'bg-sun/35',
  mint: 'bg-mint/35',
  coral: 'bg-coral/30',
  sky: 'bg-sky/35',
}
---

<header class="px-5 sm:px-8 pt-8 sm:pt-12 pb-12 sm:pb-16">
  <div class="container-page grid-12 gap-y-8 items-end double-rule pb-10 sm:pb-14">
    <div class="col-span-4 md:col-span-8">
      <span class="rise chip mb-7">{chip}</span>
      <h1 class="rise display text-[clamp(3rem,8vw,7rem)]" style="--d: 80ms">
        <slot name="title" />
      </h1>
    </div>
    <div class="rise col-span-4 md:col-span-4 text-fg/75 text-lg leading-relaxed" style="--d: 160ms">
      <slot />
    </div>
  </div>
</header>
