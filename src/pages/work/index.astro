---
export const prerender = true

import BaseLayout from '../../layouts/BaseLayout.astro'
import WorkCard from '../../components/WorkCard.astro'
import { getCollection } from 'astro:content'

const allWork = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year)
const allTags = [...new Set(allWork.flatMap((w) => w.data.tags))].sort()
---

<BaseLayout title="Work — Asif Asharaf" description="Selected product design work by Asif Asharaf: Factors.ai, Nimo, Quintype and more.">
  <div class="container-page px-6 sm:px-8 py-16 sm:py-24">
    <header class="mb-12 sm:mb-20 fade-up">
      <h1 class="font-serif text-5xl sm:text-7xl text-fg mb-4">Work</h1>
      <p class="text-muted text-lg max-w-xl">
        Nine years of product design, from a college studio in Kerala to founding designer at a B2B SaaS company. {allWork.length} projects.
      </p>
    </header>

    {
      allTags.length > 1 && (
        <div id="tag-filter" class="flex flex-wrap gap-2 mb-12">
          <button class="tag-btn active" data-tag="all">
            All
          </button>
          {allTags.map((tag) => (
            <button class="tag-btn" data-tag={tag}>
              {tag}
            </button>
          ))}
        </div>
      )
    }

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10" id="work-grid">
      {
        allWork.map((entry) => (
          <div class="work-item" data-tags={JSON.stringify(entry.data.tags)}>
            <WorkCard entry={entry} />
          </div>
        ))
      }
    </div>
  </div>

  <!-- Bottom CTA -->
  <section class="border-t border-border px-6 sm:px-8 py-20 sm:py-32">
    <div class="container-page">
      <div class="max-w-2xl" data-reveal>
        <span class="text-muted text-xs uppercase tracking-[0.22em] mb-6 block">Get in touch</span>
        <h2 class="font-serif text-3xl sm:text-5xl text-fg leading-tight mb-6">
          Have a brief worth the time?
        </h2>
        <a href="mailto:hello@asifasharaf.com" class="link-underline text-accent text-lg">
          hello@asifasharaf.com →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('#tag-filter .tag-btn')
  const items = document.querySelectorAll<HTMLElement>('.work-item')

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag ?? 'all'

      btns.forEach((b) => b.classList.remove('active'))
      btn.classList.add('active')

      items.forEach((item) => {
        const tags: string[] = JSON.parse(item.dataset.tags ?? '[]')
        item.style.display = tag === 'all' || tags.includes(tag) ? '' : 'none'
      })
    })
  })
</script>
