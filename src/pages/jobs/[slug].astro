---
export const prerender = true

import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { personColor } from '../../lib/palette'

export async function getStaticPaths() {
  const jobs = await getCollection('jobs')
  return jobs.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await entry.render()
const { title, company, location, type, tags, url, salary, postedAt, asifNote } = entry.data
const color = personColor(company)

const typeLabel: Record<string, string> = {
  'full-time': 'Full-time',
  'part-time': 'Part-time',
  contract: 'Contract',
  freelance: 'Freelance',
  internship: 'Internship',
}

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat('en-IN', { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date(d))
---

<BaseLayout title={`${title} at ${company} — Jobs`} description={asifNote ?? `${title} at ${company} — ${location}`}>
  <article class="px-5 sm:px-8 pt-10 sm:pt-16">
    <div class="relative max-w-3xl mx-auto">
      <a href="/jobs" class="arrow-link mb-10 sm:mb-14"><span class="arr">←</span> All opportunities</a>

      <header class="mb-12">
        <div class="rise flex flex-wrap items-center gap-2 mb-6">
          <span class="chip"><span class:list={['dot', color]}></span>{typeLabel[type]}</span>
          {tags.map((tag) => <span class="tag-pill">{tag}</span>)}
        </div>
        <h1 class="rise display text-5xl sm:text-7xl mb-4" style="--d: 80ms">{title}</h1>
        <p class="rise text-2xl font-medium text-fg/80 mb-8" style="--d: 120ms">{company}</p>

        <dl class="rise grid grid-cols-1 sm:grid-cols-3 border-y border-ink mb-10" style="--d: 160ms">
          <div class="py-4 sm:pr-5"><dt class="meta mb-1">Location</dt><dd>{location}</dd></div>
          <div class="py-4 sm:px-5 border-t sm:border-t-0 sm:border-l border-ink"><dt class="meta mb-1">Salary</dt><dd>{salary ?? 'Not listed'}</dd></div>
          <div class="py-4 sm:pl-5 border-t sm:border-t-0 sm:border-l border-ink"><dt class="meta mb-1">Posted</dt><dd>{formatDate(postedAt)}</dd></div>
        </dl>

        {
          asifNote && (
            <div class="mb-10 border-l-[3px] border-lilac pl-6 py-1">
              <p class="meta-fg mb-3">Asif's note</p>
              <p class="text-lg leading-relaxed font-medium">“{asifNote}”</p>
            </div>
          )
        }

        <a href={url} target="_blank" rel="noopener noreferrer" class="btn-ink">Apply / view original ↗</a>
      </header>

      <div class="prose-antigravity">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
