---
export const prerender = true

import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import PageHero from '../../components/PageHero.astro'
import { personColor } from '../../lib/palette'

const allJobs = (await getCollection('jobs'))
  .sort((a, b) => new Date(b.data.postedAt).getTime() - new Date(a.data.postedAt).getTime())

const activeJobs = allJobs.filter((j) => j.data.active)
const closedJobs = allJobs.filter((j) => !j.data.active)

const typeLabel: Record<string, string> = {
  'full-time': 'Full-time',
  'part-time': 'Part-time',
  contract: 'Contract',
  freelance: 'Freelance',
  internship: 'Internship',
}

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(d))
---

<BaseLayout
  title="Jobs & Opportunities — Asif Asharaf"
  description="Design roles and opportunities worth knowing about. Curated by Asif Asharaf."
>
  <PageHero chip="💼 Opportunities" glow="sun">
    <Fragment slot="title">Jobs worth <em class="hl-sun">texting a friend</em> about.</Fragment>
    Roles I come across that seem genuinely worth it. Not a job board, more like a list I'd send a
    friend who's looking.
  </PageHero>

  <div class="px-5 sm:px-8">
    <div class="container-page">
      {
        activeJobs.length > 0 ? (
          <section class="grid gap-6 mb-20">
            {activeJobs.map((job) => (
              <a href={`/jobs/${job.slug}`} class="group pop grid md:grid-cols-[1fr_auto] gap-6 rounded-[22px] bg-bg p-6 sm:p-8">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-5">
                    <span class:list={['chip text-[#111216]', personColor(job.data.company)]}>{typeLabel[job.data.type]}</span>
                    {job.data.tags.slice(0, 3).map((tag) => <span class="tag-pill">{tag}</span>)}
                  </div>
                  <h2 class="font-serif text-3xl sm:text-4xl leading-tight mb-2" style="font-weight:800">{job.data.title}</h2>
                  <p class="text-fg/75 text-lg mb-4">
                    {job.data.company} · {job.data.location}
                    {job.data.salary && <span class="text-muted"> · {job.data.salary}</span>}
                  </p>
                  {job.data.asifNote && (
                    <p class="max-w-3xl rounded-2xl bg-surface px-5 py-4 leading-relaxed text-fg/80">
                      <span class="font-mono text-[11px] uppercase tracking-[0.06em] text-accent block mb-1">Asif's note</span>
                      “{job.data.asifNote}”
                    </p>
                  )}
                </div>
                <div class="flex md:flex-col items-center md:items-end justify-between gap-4">
                  <span class="font-mono text-xs text-muted">Posted {formatDate(job.data.postedAt)}</span>
                  <span class="arrow-link">View role <span class="arr">→</span></span>
                </div>
              </a>
            ))}
          </section>
        ) : (
          <div class="pop rounded-[22px] bg-surface py-20 text-center mb-20">
            <p class="font-serif text-3xl mb-3" style="font-weight:800">Nothing open right now</p>
            <p class="text-muted">Check back soon. I post roles as I come across them.</p>
          </div>
        )
      }

      {
        closedJobs.length > 0 && (
          <section>
            <p class="meta mb-4">Closed / archived</p>
            {closedJobs.map((job) => (
              <div class="flex items-baseline justify-between gap-4 py-4 border-b-2 border-ink/10 opacity-60">
                <div>
                  <span class="text-fg line-through">{job.data.title}</span>
                  <span class="text-muted ml-3">{job.data.company}</span>
                </div>
                <span class="font-mono text-xs text-muted shrink-0">{formatDate(job.data.postedAt)}</span>
              </div>
            ))}
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>
