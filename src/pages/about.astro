---
export const prerender = true

import BaseLayout from '../layouts/BaseLayout.astro'
import { LINKEDIN_URL } from '../lib/social'

const experience = [
  {
    company: 'Factors.ai',
    href: '/work/factors-ai',
    roles: [
      { title: 'Lead Product Designer', period: 'Jul 2023 — now' },
      { title: 'Senior Product Designer, founding designer', period: 'Aug 2020 — Jun 2023' },
    ],
    summary:
      'First designer at a B2B go-to-market platform. Built analytics and attribution from zero, then account intelligence, real-time alerts, workflow automations, AI agents and Adpilot. Own the design system; lead and mentor the design team.',
  },
  {
    company: 'Quintype Technologies',
    href: '/work/quintype',
    roles: [
      { title: 'Senior Product Designer', period: 'Apr 2020 — Aug 2020' },
      { title: 'UI/UX Designer', period: 'May 2017 — Apr 2020' },
    ],
    summary:
      'Newsroom software for large digital publishers: Bold (CMS), Metype (engagement) and Subtype (subscriptions), and the shared design system across them.',
  },
  {
    company: 'Teezonic Digital Makers',
    roles: [{ title: 'UI Designer', period: 'Jul 2016 — May 2017' }],
    summary: 'Wireframes, prototypes, style guides and responsive interfaces for client and internal products.',
  },
  {
    company: 'Foxbrain Creative',
    href: '/work/foxbrain-creative',
    roles: [{ title: 'Founder', period: 'Jan 2015 — Jun 2017' }],
    summary:
      'A student-run studio in Cochin and Munnar. Websites, brand identities and photography, mostly for tourism and hospitality brands.',
  },
]

const skills = [
  'Product design',
  '0→1 product building',
  'Design systems',
  'AI & agentic UX',
  'B2B SaaS',
  'Data-heavy UX',
  'Workflow automation',
  'Design management',
  'Team building',
  'Front-end (HTML, CSS, JS)',
]
---

<BaseLayout
  title="About — Asif Asharaf"
  description="Lead product designer in Bengaluru. Founding designer at Factors.ai; previously Quintype; founder of Foxbrain Creative."
>
  <div class="px-5 sm:px-8 pt-14 sm:pt-24">
    <div class="container-page">
      <header class="grid-12 gap-y-8 mb-20 sm:mb-28">
        <p class="meta col-span-4 md:col-span-3">About</p>
        <h1 class="col-span-4 md:col-span-9 display text-[clamp(3rem,7.5vw,7.5rem)] max-w-[16ch]">
          A designer who likes the <em>hard</em> middle of products.
        </h1>
      </header>

      <section class="grid-12 gap-y-8" data-reveal>
        <p class="meta col-span-4 md:col-span-3">Story</p>
        <div class="col-span-4 md:col-span-6 space-y-6 text-[18px] leading-[1.7] text-fg/80">
          <p class="font-serif text-3xl sm:text-4xl leading-[1.2] text-fg">
            I'm Asif Asharaf, a lead product designer in Bengaluru. For nine years I've built B2B SaaS
            from 0→1 to scale.
          </p>
          <p>
            I joined <a href="/work/factors-ai" class="text-fg underline decoration-accent/50 underline-offset-4 hover:decoration-accent">Factors.ai</a>
            in 2020 as its first designer. I designed the platform, the design system, the logo and the
            first website. Today I lead product design across analytics, attribution, account
            intelligence, workflow automations, AI agents and Adpilot, and I manage the team that grew
            around it. Before that I spent three years on newsroom software at
            <a href="/work/quintype" class="text-fg underline decoration-accent/50 underline-offset-4 hover:decoration-accent">Quintype</a>.
          </p>
          <p>
            I started out in Kerala, in Adimali and Munnar, with a diploma in computer engineering and a
            studio I ran with friends in college. I still write front-end code, and lately I build with AI
            agents too:
            <a href="/work/nimo" class="text-fg underline decoration-accent/50 underline-offset-4 hover:decoration-accent">Nimo</a>,
            a clinical note system for Indian clinics, and
            <a href="/work/cull" class="text-fg underline decoration-accent/50 underline-offset-4 hover:decoration-accent">Cull</a>,
            an on-device photo culler. Away from the screen I photograph and make films.
          </p>
          <p>
            A lot of my time goes into mentoring designers earlier in their careers. The recommendations on my
            <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="text-fg underline decoration-accent/50 underline-offset-4 hover:decoration-accent">LinkedIn</a>
            probably say it better than I can.
          </p>
        </div>
      </section>

      <section class="grid-12 gap-y-8 pt-28 sm:pt-36" data-reveal>
        <p class="meta col-span-4 md:col-span-3">Experience</p>
        <ol class="col-span-4 md:col-span-9 border-t border-fg/80">
          {
            experience.map((job) => (
              <li class="grid grid-cols-4 md:grid-cols-9 gap-x-6 gap-y-4 py-8 border-b border-border">
                <div class="col-span-4 md:col-span-3">
                  <h2 class="font-serif text-3xl sm:text-4xl leading-none">
                    {job.href ? (
                      <a href={job.href} class="hover:text-accent transition-colors">{job.company}</a>
                    ) : (
                      job.company
                    )}
                  </h2>
                </div>
                <div class="col-span-4 md:col-span-6">
                  <ul class="space-y-1.5 mb-4">
                    {job.roles.map((r) => (
                      <li class="flex flex-wrap items-baseline justify-between gap-x-4 text-fg">
                        <span>{r.title}</span>
                        <span class="font-mono text-xs text-muted tabular-nums">{r.period}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="text-muted leading-relaxed">{job.summary}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="grid-12 gap-y-8 pt-28 sm:pt-36" data-reveal>
        <p class="meta col-span-4 md:col-span-3">Capabilities</p>
        <ul class="col-span-4 md:col-span-9 grid grid-cols-1 sm:grid-cols-2 border-t border-fg/80">
          {
            skills.map((s, i) => (
              <li class="flex items-baseline gap-4 py-4 border-b border-border font-serif text-2xl">
                <span class="font-mono text-[10px] text-accent tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                {s}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="grid-12 gap-y-8 pt-28 sm:pt-36" data-reveal>
        <p class="meta col-span-4 md:col-span-3">Education &amp; languages</p>
        <div class="col-span-4 md:col-span-9 grid sm:grid-cols-3 gap-6 border-t border-fg/80 pt-6">
          <div>
            <p class="font-serif text-2xl leading-tight">Model Engineering College</p>
            <p class="text-muted text-sm mt-2">B.Tech · <span class="font-mono text-xs">2014 — 2017</span></p>
          </div>
          <div>
            <p class="font-serif text-2xl leading-tight">Govt. Polytechnic College, Nedumkandam</p>
            <p class="text-muted text-sm mt-2">Diploma, Computer Engineering · <span class="font-mono text-xs">2011 — 2014</span></p>
          </div>
          <div>
            <p class="font-serif text-2xl leading-tight">Malayalam, English</p>
            <p class="text-muted text-sm mt-2">Some Tamil and Hindi</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
