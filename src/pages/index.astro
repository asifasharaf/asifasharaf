---
export const prerender = true

import BaseLayout from '../layouts/BaseLayout.astro'
import ProjectCover from '../components/ProjectCover.astro'
import PostCard from '../components/PostCard.astro'
import Glyph from '../components/Glyph.astro'
import { getCollection } from 'astro:content'

const featuredWork = (await getCollection('work', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year)
  .slice(0, 3)

const recentPosts = (await getCollection('writing', ({ data }) => !data.draft && !!data.publishedAt))
  .sort((a, b) => new Date(b.data.publishedAt!).getTime() - new Date(a.data.publishedAt!).getTime())
  .slice(0, 3)
---

<BaseLayout title="Asif Asharaf — Lead Product Designer, Bengaluru">
  <!-- Hero -->
  <section class="px-5 sm:px-8 pt-16 sm:pt-28 pb-24 sm:pb-36">
    <div class="container-page grid md:grid-cols-[1fr_auto] gap-12 md:gap-20 items-center">
      <div class="max-w-3xl">
        <p class="rise text-muted mb-8">Lead Product Designer at Factors.ai · Bengaluru</p>
        <h1 class="rise display text-[clamp(2.6rem,5.6vw,5rem)]" style="--d: 80ms">
          I design products that <em>actually work</em>, and help designers get better at it.
        </h1>
        <p class="rise text-lg leading-relaxed text-fg/70 mt-8 max-w-xl" style="--d: 160ms">
          Nine years building B2B SaaS from 0→1 to scale. I was the first designer at Factors.ai and now
          lead design across analytics, AI agents and automation.
        </p>
        <div class="rise flex flex-wrap gap-8 mt-10" style="--d: 240ms">
          <a href="/work" class="arrow-link">See my work <span class="arr">→</span></a>
          <button type="button" class="arrow-link" data-open-tldr>The 60-second version</button>
        </div>
      </div>

      <div class="relative w-56 sm:w-72 md:w-80 justify-self-center" aria-hidden="true">
        <Glyph name="maker" class="w-full h-auto text-fg" weight={3.2} draw delay={300} />
        <Glyph name="cursor" class="absolute right-[2%] top-[22%] w-[16%] h-auto text-accent" weight={6} draw delay={1100} />
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section class="px-5 sm:px-8" id="work">
    <div class="container-page">
      <div class="flex items-baseline justify-between mb-10">
        <h2 class="text-muted">Selected work</h2>
        <a href="/work" class="text-[15px] text-muted hover:text-fg transition-colors">All projects →</a>
      </div>

      <div class="flex flex-col">
        {
          featuredWork.map((entry, i) => (
            <a href={`/work/${entry.slug}`} class:list={['group grid md:grid-cols-[minmax(0,5fr)_minmax(0,4fr)] gap-6 md:gap-14 items-center py-10', i > 0 && 'border-t border-border']} data-reveal>
              <ProjectCover entry={entry} class="aspect-[4/3]" eager={i === 0} />
              <div>
                <h3 class="font-serif text-3xl sm:text-4xl leading-tight mb-3 group-hover:underline decoration-1 underline-offset-[6px]" style="font-weight:700">{entry.data.title}</h3>
                <p class="text-fg/70 leading-relaxed mb-4">{entry.data.description}</p>
                <p class="text-sm text-muted">{entry.data.role} · {entry.data.period ?? entry.data.year}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Writing -->
  {
    recentPosts.length > 0 && (
      <section class="px-5 sm:px-8 pt-24 sm:pt-32">
        <div class="container-page">
          <div class="flex items-baseline justify-between mb-4">
            <h2 class="text-muted">Writing</h2>
            <a href="/writing" class="text-[15px] text-muted hover:text-fg transition-colors">All writing →</a>
          </div>
          {recentPosts.map((entry) => <PostCard entry={entry} />)}
        </div>
      </section>
    )
  }

  <!-- 60-second version -->
  <dialog id="tldr" class="rounded-md border border-border bg-bg text-fg p-0 w-[min(600px,calc(100vw-2rem))] backdrop:bg-ink/30 backdrop:backdrop-blur-sm">
    <div class="p-7 sm:p-10">
      <div class="flex items-center justify-between mb-6">
        <p class="text-muted">The 60-second version</p>
        <button type="button" class="w-8 h-8 grid place-items-center text-xl text-muted hover:text-fg" data-close-tldr aria-label="Close">×</button>
      </div>
      <ul class="space-y-4 text-[17px] leading-relaxed">
        <li><strong>Lead Product Designer at Factors.ai.</strong> I joined in 2020 as the first designer and built the platform, design system, logo and first website from zero.</li>
        <li><strong>What I design now:</strong> analytics and attribution, account intelligence, real-time alerts, workflow automations, AI agents and Adpilot.</li>
        <li><strong>Before that, Quintype (2017–20):</strong> Bold CMS, Metype and Subtype for large digital newsrooms, plus their shared design system.</li>
        <li><strong>On the side:</strong> Nimo, an AI clinical-note system for Indian clinics, designed with Irfan; and Cull, an on-device photo culler.</li>
        <li><strong>I lead and mentor designers,</strong> and still write front-end code.</li>
      </ul>
      <div class="flex gap-8 mt-8">
        <a href="/work" class="arrow-link">See the work <span class="arr">→</span></a>
        <a href="/about" class="arrow-link">Full story <span class="arr">→</span></a>
      </div>
    </div>
  </dialog>
</BaseLayout>

<script is:inline>
  (function () {
    const d = document.getElementById('tldr')
    if (!d) return
    document.querySelectorAll('[data-open-tldr]').forEach((b) => b.addEventListener('click', () => d.showModal()))
    d.querySelectorAll('[data-close-tldr]').forEach((b) => b.addEventListener('click', () => d.close()))
    d.addEventListener('click', (e) => { if (e.target === d) d.close() })
  })()
</script>
