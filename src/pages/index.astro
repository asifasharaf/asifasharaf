---
export const prerender = true

import BaseLayout from '../layouts/BaseLayout.astro'
import WorkCard from '../components/WorkCard.astro'
import PostCard from '../components/PostCard.astro'
import Marquee from '../components/Marquee.astro'
import Reveal from '../components/motion/Reveal.tsx'
import Stagger from '../components/motion/Stagger.tsx'
import SplitWords from '../components/motion/SplitWords.tsx'
import { getCollection } from 'astro:content'

const featuredWork = (await getCollection('work', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year)
  .slice(0, 3)

const recentPosts = (await getCollection('writing', ({ data }) => !data.draft && !!data.publishedAt))
  .sort((a, b) => new Date(b.data.publishedAt!).getTime() - new Date(a.data.publishedAt!).getTime())
  .slice(0, 3)

---

<BaseLayout title="Asif Asharaf — Lead Product Designer, Bengaluru">
  <!-- Hero -->
  <section class="relative px-6 sm:px-8 pt-12 sm:pt-20 pb-12 sm:pb-20">
    <!-- Floating decorative asterisks -->
    <span
      aria-hidden="true"
      class="hidden md:block absolute top-20 right-12 text-olive text-3xl spin-asterisk select-none"
      style="animation-duration: 14s"
    >
      ✻
    </span>
    <span
      aria-hidden="true"
      class="hidden md:block absolute top-1/2 right-[18%] text-mustard text-2xl spin-asterisk select-none"
      style="animation-duration: 10s; animation-direction: reverse"
    >
      ✦
    </span>
    <span
      aria-hidden="true"
      class="hidden md:block absolute bottom-32 right-32 text-rose text-2xl spin-asterisk select-none"
      style="animation-duration: 18s"
    >
      ❋
    </span>

    <div class="container-page relative">
      <Reveal client:load as="div" className="flex items-center gap-3 mb-12 sm:mb-16">
        <span class="text-muted text-xs uppercase tracking-[0.2em]">Bengaluru, India</span>
        <span class="h-px w-8 bg-accent"></span>
        <span class="text-muted text-xs uppercase tracking-[0.2em]">
          Lead Product Designer · Factors.ai
        </span>
      </Reveal>

      <h1
        class="font-serif text-[clamp(2.75rem,8vw,7.5rem)] text-fg leading-[0.98] tracking-tight max-w-5xl"
      >
        <SplitWords
          client:load
          text="I design things that have to work — and help others get better at it."
          highlight={['work', 'better']}
          highlightClass="squiggle-underline"
        />
      </h1>

      <Reveal
        client:load
        delay={1.1}
        as="p"
        className="text-muted text-lg sm:text-xl mt-12 sm:mt-16 max-w-lg leading-relaxed"
      >
        Nine years building B2B SaaS from 0→1 to scale. I was the founding designer at
        Factors.ai, where I now lead product design across analytics, account
        intelligence, AI agents and automation. Before that: newsroom software at
        Quintype, and a studio of my own in Kerala.
      </Reveal>
    </div>
  </section>

  <!-- Marquee strip -->
  <Marquee
    items={[
      'Product Design',
      '0→1',
      'Design Systems',
      'AI & Agentic UX',
      'B2B SaaS',
      'Data-heavy UX',
      'Design Leadership',
      'Bengaluru',
    ]}
  />

  <!-- 01 · Selected Work -->
  {
    featuredWork.length > 0 && (
      <section class="px-6 sm:px-8 py-16 sm:py-24">
        <div class="container-page">
          <Reveal client:visible className="flex items-baseline justify-between gap-4 mb-12 sm:mb-16">
            <div class="flex items-baseline gap-4 sm:gap-6">
              <span class="section-num section-num--01">01</span>
              <h2 class="text-fg text-xs sm:text-sm uppercase tracking-[0.22em]">
                Selected Work
              </h2>
            </div>
            <a href="/work" class="link-underline text-muted hover:text-accent text-sm transition-colors">
              All work →
            </a>
          </Reveal>
          <div class:list={["grid gap-6 sm:gap-10", featuredWork.length === 2 ? "grid-cols-2" : "grid-cols-3"]} data-stagger>
            {featuredWork.map((entry) => (
              <WorkCard entry={entry} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 02 · What I do -->
  <section class="px-6 sm:px-8 py-16 sm:py-24 border-t border-border">
    <div class="container-page">
      <Reveal client:visible className="flex items-baseline gap-4 sm:gap-6 mb-12 sm:mb-16">
        <span class="section-num section-num--02">02</span>
        <h2 class="text-fg text-xs sm:text-sm uppercase tracking-[0.22em]">What I Do</h2>
      </Reveal>

      <div class="grid grid-cols-3 gap-8 sm:gap-16 max-w-5xl" data-stagger>
        <div>
          <h3 class="font-serif text-3xl sm:text-4xl text-fg leading-tight mb-4">
            0→1 products
          </h3>
          <p class="text-muted leading-relaxed">
            Taking a product from a blank Figma file to something a company runs on:
            research, strategy, information architecture, data-dense UI, and shipping
            it with engineering. I've done it at Factors.ai, and again with Nimo.
          </p>
        </div>
        <div>
          <h3 class="font-serif text-3xl sm:text-4xl text-fg leading-tight mb-4">
            Design systems
          </h3>
          <p class="text-muted leading-relaxed">
            Component libraries, tokens and the documentation around them, so a small
            team can ship a wide product that still feels like one thing. I've built
            them for Quintype's platform and from scratch at Factors.ai.
          </p>
        </div>
        <div>
          <h3 class="font-serif text-3xl sm:text-4xl text-fg leading-tight mb-4">
            Design leadership
          </h3>
          <p class="text-muted leading-relaxed">
            Growing a design team from one person: hiring foundations, process,
            and close work with founders, PMs and engineers. I also mentor designers
            earlier in their careers, giving the feedback I wish I'd had.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured interactive -->
  <section class="px-6 sm:px-8 py-16 sm:py-24 border-t border-border">
    <div class="container-page">
      <Reveal client:visible>
        <a href="/ai-and-design" class="group block">
          <div class="flex items-baseline gap-4 sm:gap-6 mb-8 sm:mb-10">
            <span class="section-num section-num--05">✳</span>
            <h2 class="text-fg text-xs sm:text-sm uppercase tracking-[0.22em]">
              Interactive
            </h2>
          </div>
          <div class="grid md:grid-cols-[minmax(0,1fr)_auto] gap-8 md:gap-16 items-end">
            <div>
              <h3
                class="font-serif text-3xl sm:text-5xl text-fg leading-tight mb-5 group-hover:text-accent transition-colors"
              >
                What AI does to design work
              </h3>
              <p class="text-muted leading-relaxed max-w-xl">
                A task-level model of how AI changes design jobs, built around Indian
                design employment. Twenty-nine tasks, five levers, four futures — set
                the assumptions yourself and see what follows.
              </p>
            </div>
            <span class="text-accent text-sm whitespace-nowrap link-underline">
              Open the explorer →
            </span>
          </div>
        </a>
      </Reveal>
    </div>
  </section>

  <!-- 03 · Writing -->
  {
    recentPosts.length > 0 && (
      <section class="px-6 sm:px-8 py-16 sm:py-24 border-t border-border">
        <div class="container-page">
          <Reveal client:visible className="flex items-baseline justify-between gap-4 mb-12 sm:mb-16">
            <div class="flex items-baseline gap-4 sm:gap-6">
              <span class="section-num section-num--03">03</span>
              <h2 class="text-fg text-xs sm:text-sm uppercase tracking-[0.22em]">Writing</h2>
            </div>
            <a href="/writing" class="link-underline text-muted hover:text-accent text-sm transition-colors">
              All writing →
            </a>
          </Reveal>
          <Stagger client:visible>
            {recentPosts.map((entry) => (
              <PostCard entry={entry} />
            ))}
          </Stagger>
        </div>
      </section>
    )
  }

  <!-- Closing CTA -->
  <section class="px-6 sm:px-8 py-24 sm:py-40 border-t border-border">
    <div class="container-page">
      <Reveal client:visible>
        <div class="max-w-4xl">
          <span class="text-muted text-xs uppercase tracking-[0.22em] mb-8 block">
            Get in touch
          </span>
          <h2 class="font-serif text-4xl sm:text-6xl text-fg leading-tight mb-8">
            Have a project that deserves the time?
          </h2>
          <a
            href="mailto:hello@asifasharaf.com"
            class="link-underline text-accent text-lg sm:text-xl"
          >
            hello@asifasharaf.com →
          </a>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>
